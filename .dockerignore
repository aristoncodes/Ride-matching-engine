# Build context hygiene. Everything here is either a build product, machine
# specific, or irrelevant to an image — and every byte sent to the daemon slows
# the build and can bust a layer cache.

.git
.github
**/build/
**/build-*/
infrastructure/gen/
matching_engine/gen/
# The road extract IS needed in the build context now: matching_engine/Dockerfile
# bakes a default graph into the image so `kubectl apply` needs no volume
# plumbing. Only the raw untrimmed downloads are excluded.
matching_engine/data/*.osm.pbf
matching_engine/data/raw/
weekly report/
docs/
!docs/api/matching.proto
*.md
.DS_Store
**/benchmark_results.txt
