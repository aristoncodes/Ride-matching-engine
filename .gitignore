# CMake build output — generated, machine-specific (absolute paths in cache),
# and reproducible from source. Never commit it.
matching_engine/build/
build/

# Compiled artifacts
*.o
*.obj
*.exe
*.out
*.a
*.so
*.dylib

# OS / editor cruft
.DS_Store
*.swp
*~
.idea/
.vscode/

# Sanitizer / scratch build trees
matching_engine/build-*/

# Benchmark output written by `unit_tests "[perf]"`. The committed numbers live
# in docs/Benchmarks.md; this file is a per-run artifact.
benchmark_results.txt

# Generated protobuf/gRPC stubs. Build products of docs/api/matching.proto —
# regenerate with `make proto`. A checked-in copy is a second source of truth
# waiting to go stale.
infrastructure/gen/
matching_engine/gen/

# NOT ignored, on purpose: matching_engine/data/bengaluru_roads.osm
#
# The one data blob that is committed. Every routing benchmark and the 1.51x
# detour-factor measurement is quoted against THAT extract, so a reader who
# re-downloads a fresh one from OpenStreetMap gets different numbers and no way
# to tell whether the code or the map changed. Committing it is what makes the
# claims reproducible.

# Local compose env (may contain machine-specific config)
.env

# pprof captures. Regenerate with ./scripts/profile.sh; the .pb.gz files are
# machine- and run-specific, so only the analysis is worth committing.
profiles/
