benchmark_results.txt

# Generated protobuf/gRPC stubs. Build products of docs/api/matching.proto —
# regenerate with `make proto`. A checked-in copy is a second source of truth
# waiting to go stale.
infrastructure/gen/
matching_engine/gen/
