# Copy to .env and adjust. Compose reads .env automatically.
#
# Config lives HERE, not in docker-compose.yml, so the compose file is
# identical across environments and only the values change. Real secrets
# (API keys, Week 18) belong in a secret manager rather than this file —
# .env is gitignored, but "gitignored" is not "secure".

# --- ports (host side) ---
REDIS_PORT=6379
ENGINE_PORT=50051
INGEST_PORT=8080
REQUEST_PORT=8081
BATCHER_PORT=8082

# --- image tag ---
# Overridden in CI with a version or a git SHA; :dev locally.
TAG=dev

# --- application config ---
TENANT_ID=default

# The 3-second batch window from ADR-0005. Shared by ingestd and batcherd
# because they must agree: the cache is refreshed on this cadence and matched
# on the same one.
BATCH_WINDOW=3s

# How long a driver stays matchable after their last ping (~10 missed pings).
DRIVER_TTL=30s

# Flush a batch early once this many requests accumulate.
MAX_BATCH=500

# Candidate drivers per rider (k). Week 5 measured this as the difference
# between a 0.4 ms and a 3.8 ms solve at N=M=100.
CANDIDATES_PER_RIDER=8

# Road graph id, and the file mounted at /data in the engine container.
ROAD_GRAPH_ID=blr-central

# Per-batch caps enforced by the C++ engine. Above these it returns
# RESOURCE_EXHAUSTED rather than attempting the batch.
ENGINE_MAX_RIDERS=20000
ENGINE_MAX_DRIVERS=20000

# --- redis ---
REDIS_MAXMEMORY=512mb

# =============================================================================
# PRODUCTION ONLY — used by deploy/docker-compose.prod.yml
# =============================================================================
# The dev stack above ignores all of these. The overlay declares the first
# three with `:?`, so compose refuses to start rather than silently deploying
# without them — a missing password must be a startup failure, not a default.

# The hostname you own and have pointed at this machine's public IP. Caddy
# requests a certificate for exactly this name, so a typo here is a failed
# ACME challenge rather than an insecure deploy.
RIDEMATCH_DOMAIN=api.example.com

# Where Let's Encrypt sends expiry warnings. A real address you read.
ACME_EMAIL=you@example.com

# Redis password. Generate it, never type it:
#   openssl rand -base64 32
# Changing it later requires restarting the whole stack, since every service
# authenticates at connect time.
REDIS_PASSWORD=

# Browser Origins allowed to open a driver stream. Leave EMPTY unless you have
# a browser dashboard — native driver apps send no Origin header and are
# unaffected. Comma-separated, exact matches, scheme included.
ALLOWED_ORIGINS=

# WebSocket connection ceiling. Past this, ingestd returns 503 rather than
# accepting connections it cannot serve. Size it to the box: Week 15 measured
# 10,000 concurrent drivers holding steady at p99 8.35 ms.
MAX_CONNS=20000
