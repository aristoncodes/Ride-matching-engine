# Cloud Run environment for the copilot. Copy to env.cloudrun.yaml (gitignored), fill REPLACE_ME.
# Format: YAML, one KEY: "value" per line (what `gcloud run deploy --env-vars-file` expects).
# Never commit the filled-in file. All tokens must be different from each other.

COPILOT_API_TOKEN: "REPLACE_ME"
COPILOT_WEBHOOK_TOKEN: "REPLACE_ME"
# name=token pairs, comma-separated. Quote the whole value because of the = and the comma.
COPILOT_APPROVERS: "alice=REPLACE_ME,bob=REPLACE_ME"

# Neon, roles copilot_app and copilot_ro (see README step 2). Keep ?sslmode=require.
COPILOT_DB_DSN: "postgresql://copilot_app:REPLACE_ME@REPLACE_HOST/REPLACE_DB?sslmode=require"
COPILOT_RO_DSN: "postgresql://copilot_ro:REPLACE_ME@REPLACE_HOST/REPLACE_DB?sslmode=require"

# Gemini through its OpenAI-compatible endpoint (to check against Google's current docs).
LLM_BASE_URL: "https://generativelanguage.googleapis.com/v1beta/openai"
LLM_API_KEY: "REPLACE_ME"
GROQ_MODEL: "gemini-2.5-flash"   # the variable name is historical; it names the model for any provider
MODEL_CALL_TIMEOUT_S: "60"

# No cluster on Cloud Run.
COPILOT_K8S_ACTIONS: "off"

# Must point at a Prometheus Cloud Run can reach. Not available until the recorded-window
# replay exists; see README, "What will not work yet".
PROMETHEUS_URL: "REPLACE_ME"

# Optional. Leave out to run without the model cache.
# REDIS_URL: "rediss://REPLACE_ME"

# Optional tracing to the Cloud Run logs (span names and attributes only, never prompts).
# OTEL_TRACES_EXPORTER: "console"
