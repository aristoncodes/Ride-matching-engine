# Copy to .env for local development. Placeholders only; never commit real values.

# libpq settings for the fault injector's own role (writes incidents_truth; the copilot never
# reads it). Used by k8s/fault-inject.sh. Placeholders only; never commit real values.
PGHOST=REPLACE_ME
PGPORT=REPLACE_ME
PGUSER=REPLACE_ME
PGDATABASE=REPLACE_ME
PGPASSWORD=REPLACE_ME

# DSN for the copilot's own Postgres database (pgvector enabled). Use the copilot_app role
# at runtime (copilot_ro for the logs agent); the owner/superuser DSN is only for apply_schema.
COPILOT_DB_DSN=postgresql://copilot_app:PASSWORD@localhost:5432/copilot
# Read-only DSN for the logs agent (role copilot_ro, password COPILOT_RO_PASSWORD).
COPILOT_RO_DSN=postgresql://copilot_ro:PASSWORD@localhost:5432/copilot
# Required by the API. Generate a random value and store it in a Secret, never in git.
COPILOT_API_TOKEN=REPLACE_ME

# Owner/superuser password for the local compose Postgres service (runs schema + grants).
COPILOT_DB_PASSWORD=REPLACE_ME

# Role passwords read by copilot/initdb/01-roles.sql. Unset locally uses the compose dev default.
COPILOT_APP_PASSWORD=REPLACE_ME
COPILOT_RO_PASSWORD=REPLACE_ME
FAULT_INJECTOR_PASSWORD=REPLACE_ME

# Prometheus base URL used for metric queries.
PROMETHEUS_URL=http://localhost:9090

# Bearer token required by the copilot HTTP API.
COPILOT_API_TOKEN=REPLACE_ME

# Google Cloud / Vertex AI settings (used in a later phase).
VERTEX_PROJECT=REPLACE_ME
VERTEX_LOCATION=REPLACE_ME

# Redis connection URL.
REDIS_URL=redis://localhost:6379/0
